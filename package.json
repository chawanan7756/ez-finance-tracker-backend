{
    "name": "finance-tracker-backend",
    "version": "1.0.0",
    "description": "Backend for Financial Tracking App with LINE Integration",
    "main": "src/index.js",
    "engines": {
        "node": ">=18"
    },
    "scripts": {
        "dev": "nodemon src/index.js",
